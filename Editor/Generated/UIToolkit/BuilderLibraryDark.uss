.unity-builder-library__controls-category-foldout > .unity-foldout__header > .unity-toggle {
    background-color: rgb(43, 43, 47);
}

.unity-builder-library__controls-category-foldout > .unity-foldout__header > .unity-toggle:hover {
    background-color: rgb(50, 50, 54);
}

.unity-builder-library__header-button-strip {
    border-color: rgb(17, 17, 21);
}

.plain-view__item--selected-no-focus {
    background-color: rgb(37, 37, 41);
}

.plain-view__item:hover {
    background-color: rgb(23, 23, 27);
}

