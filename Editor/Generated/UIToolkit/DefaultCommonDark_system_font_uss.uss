.unity-button {
    background-color: rgb(43, 43, 47);
    border-left-color: rgb(23, 23, 27);
    border-top-color: rgb(23, 23, 27);
    border-right-color: rgb(23, 23, 27);
    border-bottom-color: rgb(17, 17, 21);
}

.unity-button:hover:enabled {
    background-color: rgb(50, 50, 54);
}

.unity-button:active:enabled {
    border-color: rgb(17, 17, 21);
    border-top-color: rgb(5, 5, 9);
}

.unity-button:checked {
    border-color: rgb(17, 17, 21);
    border-top-color: rgb(5, 5, 9);
}

.unity-radio-button__checkmark-background {
    background-color: rgb(20, 20, 24);
    border-color: rgb(15, 15, 19);
}

.unity-radio-button > .unity-radio-button__input:hover:enabled > .unity-radio-button__checkmark-background {
    border-color: rgb(49, 49, 53);
}

.unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgb(46, 46, 50);
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: rgb(46, 46, 50);
}

.unity-base-slider__tracker:disabled {
    background-color: rgb(42, 42, 46);
}

.unity-base-slider__dragger:disabled {
    border-color: rgb(50, 50, 54);
    background-color: rgb(50, 50, 54);
}

.unity-base-slider__fill:disabled {
    background-color: rgb(50, 50, 54);
}

.unity-min-max-slider__tracker {
    background-color: rgb(46, 46, 50);
}

.unity-min-max-slider__min-thumb {
    border-color: rgb(23, 23, 27);
}

.unity-min-max-slider__max-thumb {
    border-color: rgb(23, 23, 27);
}

.unity-scroller--horizontal > .unity-scroller__low-button:hover:enabled {
    background-color: rgb(35, 35, 39);
}

.unity-scroller--horizontal > .unity-scroller__high-button:hover:enabled {
    background-color: rgb(35, 35, 39);
}

.unity-scroller--vertical > .unity-scroller__low-button:hover:enabled {
    background-color: rgb(35, 35, 39);
}

.unity-scroller--vertical > .unity-scroller__high-button:hover:enabled {
    background-color: rgb(35, 35, 39);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    border-color: rgb(24, 24, 28);
    background-color: rgb(46, 46, 50);
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    border-color: rgb(24, 24, 28);
    background-color: rgb(46, 46, 50);
}

.unity-scroller--vertical .unity-base-slider__dragger:hover:enabled {
    background-color: rgb(51, 51, 55);
}

.unity-scroller--horizontal .unity-base-slider__dragger:hover:enabled {
    background-color: rgb(51, 51, 55);
}

.unity-scroller--horizontal .unity-base-slider__input:focus:enabled .unity-base-slider__dragger {
    background-color: rgb(46, 46, 50);
}

.unity-scroller--vertical .unity-base-slider__input:focus:enabled .unity-base-slider__dragger {
    background-color: rgb(46, 46, 50);
}

.unity-scroller--vertical .unity-base-slider__input:focus:enabled .unity-base-slider__dragger:hover:enabled {
    background-color: rgb(51, 51, 55);
}

.unity-scroller--horizontal .unity-base-slider__input:focus:enabled .unity-base-slider__dragger:hover:enabled {
    background-color: rgb(51, 51, 55);
}

.unity-box {
    background-color: rgba(19, 19, 23, 0.3);
}

.unity-popup-window {
    background-color: rgba(27, 27, 31, 0.95);
    border-color: rgb(17, 17, 21);
}

.unity-enum-field__input {
    border-left-color: rgb(23, 23, 27);
    border-top-color: rgb(23, 23, 27);
    border-right-color: rgb(23, 23, 27);
    border-bottom-color: rgb(17, 17, 21);
    background-color: rgb(39, 39, 43);
}

.unity-base-popup-field__input {
    border-left-color: rgb(23, 23, 27);
    border-top-color: rgb(23, 23, 27);
    border-right-color: rgb(23, 23, 27);
    border-bottom-color: rgb(17, 17, 21);
    background-color: rgb(39, 39, 43);
}

.unity-enum-field:hover:enabled > .unity-enum-field__input {
    background-color: rgb(43, 43, 47);
}

.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input {
    background-color: rgb(43, 43, 47);
}

.unity-base-dropdown__container-outer {
    border-color: rgb(17, 17, 21);
    background-color: rgb(17, 17, 21);
}

.unity-base-dropdown__container-inner {
    background-color: rgb(30, 30, 34);
    border-color: rgb(49, 49, 53);
}

.unity-base-dropdown__separator {
    background-color: rgb(49, 49, 53);
}

.unity-progress-bar__background {
    border-color: rgb(17, 17, 21);
    background-color: rgb(23, 23, 27);
}

.unity-base-text-field__input {
    background-color: rgb(20, 20, 24);
    border-left-color: rgb(15, 15, 19);
    border-top-color: rgb(5, 5, 9);
    border-right-color: rgb(15, 15, 19);
    border-bottom-color: rgb(15, 15, 19);
}

.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    border-color: rgb(49, 49, 53);
}

.unity-base-text-field__input:hover:enabled {
    border-color: rgb(49, 49, 53);
}

.unity-collection-view__item--alternative-background {
    background-color: rgb(30, 30, 34);
}

.unity-collection-view__item:hover:enabled {
    background-color: rgb(23, 23, 27);
}

.unity-collection-view__reorderable-item:hover:enabled {
    background-color: rgb(23, 23, 27);
}

.unity-collection-view__item--selected {
    background-color: rgb(37, 37, 41);
}

.unity-collection-view--with-border {
    border-color: rgb(15, 15, 19);
}

.unity-collection-view__item.unity-collection-view__item--drag-hover {
    background-color: rgb(32, 32, 36);
}

.unity-tree-view {
