PortInputView > #container {
    background-color: rgba(30, 30, 34, 0.8);
    border-color: rgba(11, 11, 15, 0.8);
}

PortInputView > #container > #disabledOverlay {
    background-color: rgba(15, 15, 19, 0);
}

PortInputView.disabled > #container > #disabledOverlay {
    background-color: rgba(15, 15, 19, 0.75);
}

PortInputView > #container > #slot {
    background-color: rgb(20, 20, 24);
    border-color: rgb(16, 16, 20);
}

