    --theme-header-bar-background-color-hover: rgb(33, 33, 37);
    --theme-header-bar-border-color: rgb(19, 19, 23);
    --theme-experimental-tag-background-color: rgb(14, 15, 15);
    --theme-popup-border-color: rgb(48, 48, 52);
}

