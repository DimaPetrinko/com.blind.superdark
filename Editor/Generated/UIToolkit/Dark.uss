.tab-close-button {
    background-color: rgb(19, 19, 23);
}

.tab-close-button:focus {
    background-color: rgba(32, 32, 36, 0.9);
}

.game-object-tree-view {
    -unity-object-tree-hovered-color: rgb(33, 33, 37);
}

.game-object-tree-view-scene-visibility {
    -unity-object-hovered-color: rgb(31, 31, 35);
    -unity-object-selected-no-focus-color: rgb(32, 32, 36);
    background-color: rgb(23, 23, 27);
}

.unity-theme-env-variables {
    --theme-window-border-color: rgb(17, 17, 21);
    --theme-window-background-color: rgba(27, 27, 31, 0.95);
    --theme-toolbar-button-border-color: rgb(9, 9, 13);
