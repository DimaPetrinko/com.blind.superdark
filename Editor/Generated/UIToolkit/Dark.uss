.scene-template-variables {
    --theme-footer-bar-background-color: rgb(31, 31, 35);
    --theme-preview-area-background-color: rgb(23, 23, 27);
    --theme-title-background-color: rgb(30, 30, 34);
    --theme-title-background-color-hover: rgb(34, 34, 38);
    --theme-border-color: rgb(16, 16, 20);
    --theme-header-bar-border-color: rgb(19, 19, 23);
    --theme-help-box-border-color: rgb(12, 12, 16);
}

.grid-view-header {
    border-color: rgb(16, 16, 20);
    background-color: rgb(22, 22, 26);
}

.dependency-list-view {
    border-color: rgb(14, 14, 18);
}

.dependency-list-view-header {
    background-color: rgb(14, 14, 18);
}

:root {
    --button-background-color: rgb(44, 43, 44);
    --standout-background-color: rgb(44, 43, 44);
    --expander-background-color: rgb(30, 30, 34);
    --expander-bottom-border-color: rgb(35, 35, 39);
    --tag-preview-background-color: rgb(14, 15, 15);
    --tag-verified-background-color: rgb(14, 15, 15);
    --tag-custom-background-color: rgb(14, 15, 15);
    --tag-scoped-registry-background-color: rgb(19, 19, 23);
    --tag-deprecated-version-background-color: rgb(14, 15, 15);
    --tag-deprecated-background-color: rgb(14, 15, 15);
    --progressbar-background-color: rgb(17, 15, 15);
    --group-background-color: rgb(23, 23, 27);
    --dropdown-background-color: rgb(23, 23, 27);
    --helpbox-background-color: rgba(13, 13, 14, 0.9);
    --version-foldout-color: rgb(27, 27, 31);
    --version-separator-color: rgb(37, 37, 41);
    --feature-dependency-color: rgb(27, 27, 31);
    --feature-dependency-selected-color: rgb(21, 20, 21);
    --details-header-color: rgb(27, 27, 31);
    --details-body-color: rgb(21, 20, 21);
    --details-selected-tab-button-color: rgb(29, 29, 33);
    --details-hovered-tab-button-color: rgb(39, 39, 43);
    --package-details-background-color: rgb(14, 14, 18);
    --package-item-color: rgb(27, 27, 31);
    --custom-display-dialog-upper-container-default-background-color: rgb(19, 19, 23);
    --export-window-details-background-color: rgb(32, 32, 36);
    --export-window-details-technical-border-color: rgb(16, 16, 20);
    --export-window-top-border-color: rgb(4, 4, 8);
}

.unity-theme-env-variables {
    --theme-window-border-color: rgb(17, 17, 21);
    --theme-window-background-color: rgba(27, 27, 31, 0.95);
    --theme-toolbar-button-border-color: rgb(9, 9, 13);
    --theme-help-box-background-color: rgb(30, 30, 34);
    --theme-help-box-border-color: rgb(12, 12, 16);
    --theme-view-background-color: rgb(27, 27, 31);
    --theme-line-background-color-hover: rgb(23, 23, 27);
    --theme-line-background-color-drop-hover: rgb(32, 32, 36);
    --theme-background-color-alternate: rgb(30, 30, 34);
    --theme-line-selection-background-color: rgb(37, 37, 41);
    --progress-bar-back-background-color: rgb(23, 23, 27);
    --progress-bar-back-border-color: rgb(17, 17, 21);
    --theme-header-bar-background-color: rgb(31, 31, 35);
    --theme-header-bar-background-color-hover: rgb(33, 33, 37);
    --theme-header-bar-border-color: rgb(19, 19, 23);
    --theme-experimental-tag-background-color: rgb(14, 15, 15);
    --theme-popup-border-color: rgb(48, 48, 52);
}

.unity-gradient-field__border {
    border-color: rgb(13, 13, 17);
}

